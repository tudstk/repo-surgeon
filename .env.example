# Local PostgreSQL development defaults. Copy this file to .env before starting Compose.
# These values are for local development only and must not be reused in deployed systems.
POSTGRES_USER=repo_surgeon
POSTGRES_PASSWORD=repo_surgeon_local_only
POSTGRES_DB=repo_surgeon
REPO_SURGEON_DATABASE_URL=postgresql+asyncpg://repo_surgeon:repo_surgeon_local_only@127.0.0.1:5432/repo_surgeon
