# Local PostgreSQL development defaults. Copy this file to .env before starting Compose.
# These values are for local development only and must not be reused in deployed systems.
POSTGRES_USER=repo_surgeon
POSTGRES_PASSWORD=repo_surgeon_local_only
POSTGRES_DB=repo_surgeon
REPO_SURGEON_DATABASE_URL=postgresql+asyncpg://repo_surgeon:repo_surgeon_local_only@127.0.0.1:5432/repo_surgeon

# Access policy. Keep local_trusted for local development only.
REPO_SURGEON_ACCESS_MODE=local_trusted
REPO_SURGEON_PUBLIC_ORIGIN=http://127.0.0.1:3000
REPO_SURGEON_LOCAL_REPOSITORY_ACCESS=true
REPO_SURGEON_ALLOWED_HOSTS=["127.0.0.1","localhost"]
REPO_SURGEON_CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Public-authenticated mode placeholders only. Do not put real credentials in this file.
# REPO_SURGEON_ACCESS_MODE=public_authenticated
# REPO_SURGEON_LOCAL_REPOSITORY_ACCESS=false
# REPO_SURGEON_GITHUB_OAUTH_CLIENT_ID=replace-at-runtime
# REPO_SURGEON_GITHUB_OAUTH_CLIENT_SECRET=replace-at-runtime
# REPO_SURGEON_AUTH_ENCRYPTION_KEY=replace-at-runtime
# REPO_SURGEON_COOKIE_SECURE=true
